PORT=4000
NODE_ENV=development

JWT_SECRET=dev-jwt-secret-change-me-in-production-use-32+chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

TRUST_PROXY=0

REDIS_URL=redis://127.0.0.1:6379
REDIS_POSITIONS_CHANNEL=flight:positions
REDIS_SNAPSHOT_PREFIX=flight:snapshot:

OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_POLL_INTERVAL_MS=15000
OPENSKY_TIMEOUT_MS=8000
OPENSKY_MAX_RETRIES=4
OPENSKY_BACKOFF_BASE_MS=500
OPENSKY_BACKOFF_MAX_MS=8000
OPENSKY_BBOX=12,30,35,60

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

REALTIME_ENGINE_URL=http://127.0.0.1:4100
REALTIME_ENGINE_ALLOWED_HOSTS=127.0.0.1,localhost,realtime-engine
INTERNAL_API_TOKEN=dev-internal-token-change-me
