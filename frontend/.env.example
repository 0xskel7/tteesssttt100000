# Optional Cesium Ion token for high-quality terrain/imagery
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Optional glTF/GLB aircraft model. If missing or failing to load,
# the globe automatically falls back to a 2D canvas billboard.
NEXT_PUBLIC_AIRCRAFT_MODEL_URL=/models/aircraft.glb

# Realtime engine (Socket.io)
NEXT_PUBLIC_REALTIME_URL=http://localhost:4100
