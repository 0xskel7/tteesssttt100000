PORT=4100
HOST=0.0.0.0
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
REDIS_POSITIONS_CHANNEL=flight:positions
REDIS_SNAPSHOT_PREFIX=flight:snapshot:
WS_MAX_CONNECTIONS_PER_IP=5
WS_MAX_SUBSCRIBE_PER_MINUTE=60
WS_MAX_EVENTS_PER_SECOND=20
WS_SUBSCRIBE_BURST=10
WS_MAX_ROOMS_PER_SOCKET=50
TRUST_PROXY=0
POSITION_SNAPSHOT_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERNAL_API_TOKEN=dev-internal-token-change-me
JWT_SECRET=dev-jwt-secret-change-me-in-production-use-32+chars
JWT_ISSUER=flight-platform
JWT_AUDIENCE=api
